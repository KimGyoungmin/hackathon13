<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.hackerton.mapper.FestivalDetailMapper">

    <!-- FestivalDetail ResultMap -->
    <resultMap id="FestivalDetailResultMap" type="com.example.hackerton.domain.FestivalDetail">
        <id property="festivalId" column="festival_id"/>
        <result property="festivalName" column="festival_name"/>
        <result property="totalVisitors" column="total_visitors"/>
        <result property="avgDailyVisitors" column="avg_daily_visitors"/>
        <result property="durationDays" column="duration_days"/>
        <result property="weekendDays" column="weekend_days"/>
        <result property="lodgingDays" column="lodging_days"/>
        <result property="lodgingVisitorRatio" column="lodging_visitor_ratio"/>
        <result property="avgSpendPerDayKrw" column="avg_spend_per_day_krw"/>
        <result property="stayDaysWeight" column="stay_days_weight"/>
        <result property="avgTempC" column="avg_temp_c"/>
        <result property="totalPrecipMm" column="total_precip_mm"/>
        <result property="sunshineHours" column="sunshine_hours"/>
        <result property="trafficCongestion" column="traffic_congestion"/>
        <result property="field" column="field"/>
        <result property="grdpPerCapitaMkrw" column="grdp_per_capita_mkrw"/>
        <result property="programCount" column="program_count"/>
        <result property="promoIntensityIndex" column="promo_intensity_index"/>
        <result property="budgetKrw" column="budget_krw"/>
        <result property="year" column="year"/>
        <result property="grossSales" column="gross_sales"/>
    </resultMap>
</mapper>
