<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.hackerton.mapper.FestivalMapper">

    <!-- Festival ResultMap -->
    <resultMap id="FestivalResultMap" type="com.example.hackerton.domain.Festival">
        <id property="festivalId" column="festival_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="locationId" column="location_id"/>
        <result property="festivalNm" column="festival_nm"/>
        <result property="year" column="year"/>
    </resultMap>

    <!-- 특정 지역의 모든 축제 조회 -->
    <select id="findFestivalsByLocation" resultMap="FestivalResultMap">
        SELECT 
            f.festival_id,
            f.category_id,
            f.location_id,
            f.festival_nm,
            fd.year
        FROM festival f
        LEFT JOIN festival_detail fd ON f.festival_id = fd.festival_id
        WHERE f.location_id = #{locationId}
        ORDER BY f.festival_nm, fd.year
    </select>
    
    <!-- 특정 지역과 카테고리로 축제 필터링 조회 -->
    <select id="findFestivalsByLocationAndCategories" resultMap="FestivalResultMap">
        SELECT 
            f.festival_id,
            f.category_id,
            f.location_id,
            f.festival_nm,
            fd.year
        FROM festival f
        LEFT JOIN festival_detail fd ON f.festival_id = fd.festival_id
        WHERE f.location_id = #{locationId}
        <if test="categoryIds != null and categoryIds.size() > 0">
            AND f.category_id IN
            <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                #{categoryId}
            </foreach>
        </if>
        ORDER BY f.festival_nm, fd.year
    </select>

</mapper>